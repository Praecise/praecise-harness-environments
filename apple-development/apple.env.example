# Values for your Apple Developer team. Copy to apple.env and fill in.
# developer.apple.com/account > Membership details
APPLE_TEAM_ID=ABCDE12345
APPLE_TEAM_NAME=Example Ltd
# Reverse-DNS prefix for bundle identifiers, without a trailing dot
APPLE_BUNDLE_PREFIX=com.example
# Exact name of your development identity: security find-identity -v -p codesigning
APPLE_DEVELOPMENT_IDENTITY=Apple Development: Jane Doe (ABCDE12345)
# Name you gave: xcrun notarytool store-credentials <name>
APPLE_NOTARY_PROFILE=example-notary
