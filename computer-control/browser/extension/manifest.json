{
  "manifest_version": 3,
  "name": "Praecise Control",
  "version": "0.1.0",
  "description": "Lets an agent on this machine work one tab you offer it, on the site it is on, until you stop it.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Praecise Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mark-16.png",
      "32": "icons/mark-32.png"
    }
  },
  "icons": {
    "16": "icons/mark-16.png",
    "32": "icons/mark-32.png",
    "48": "icons/mark-48.png",
    "128": "icons/mark-128.png"
  }
}
